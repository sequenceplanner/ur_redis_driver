# claude_zero_ftsensor
#
# New template. Zeroes the force/torque sensor at the current pose.
#
# Every force-guarded template compares against a baseline, and the baseline is
# only meaningful if the sensor was zeroed with the real tool mounted and nothing
# touching it. Doing it as its own command lets that happen once, after a tool
# change, instead of on every move.
#
# e-Series only. On a CB3 there is no zero_ftsensor() and this will fail on the
# controller - set use_zero_ftsensor false on the move templates there and rely
# on their baseline sampling alone.
#
# Optional parameters:
#   steady_timeout      (1.0)  - seconds to wait for the arm to reach standstill
#                                before refusing. is_steady() needs 500ms of
#                                stillness, so a single check would fail a script
#                                that starts right after the previous one.

def cl_wait_steady(timeout):
  # is_steady() only turns true after 500ms of standstill with zero target
  # velocity, so a script that starts right after the previous one finished
  # braking sees false for up to half a second. Checking it once would fail
  # perfectly good requests; this waits for it instead.
  local waited = 0.0
  while not is_steady():
    if waited >= timeout:
      return False
    end
    sleep(0.02)
    waited = waited + 0.02
  end
  return True
end

def script():
  if not cl_wait_steady({{ steady_timeout | default(value=1.0) }}):
    socket_send_line("The arm did not come to a standstill, refusing to zero the F/T sensor.", "ur_driver_socket")
    return False
  end
  {%- if use_payload %}
  set_target_payload({{ payload }})
  {%- endif %}
  set_tcp({{ tcp_in_faceplate }})
  sleep(0.2)
  zero_ftsensor()
  sleep(0.2)
  socket_send_line("ftsensor zeroed, residual wrench " + to_str(get_tcp_force()), "ur_driver_socket")
  return True
end
