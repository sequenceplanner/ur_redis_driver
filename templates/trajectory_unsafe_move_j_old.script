def script():
  {%- if use_payload %}
  set_target_payload({{ payload }})
  {%- endif %}
  socket_send_line("Starting blended trajectory.", "ur_driver_socket")
  
  {%- for wp in waypoints %}
  set_tcp({{ wp.tcp_in_faceplate }})
  {% if wp.use_joint_positions -%}
  socket_send_line("movej without inverse kinematics starting.", "ur_driver_socket")
  movej({{ wp.joint_positions }}, a={{ wp.accelleration }}, v={{ wp.velocity }}
  {%- if wp.use_execution_time -%}
  , t={{ wp.execution_time }}
  {%- endif -%}
  {%- if wp.use_blend_radius -%}
  , r={{ wp.blend_radius }}
  {%- endif -%})
  {% else -%}
  if get_inverse_kin_has_solution({{ wp.target_in_base }}
  {%- if wp.use_preferred_joint_config -%}
  , qnear={{ wp.preferred_joint_config }}
  {%- endif -%}):
    socket_send_line("Solution found, start movej.", "ur_driver_socket")
    movej(get_inverse_kin({{ wp.target_in_base }}
      {%- if wp.use_preferred_joint_config -%}
      , qnear={{ wp.preferred_joint_config }}
      {%- endif -%})
    , a={{ wp.accelleration }}, v={{ wp.velocity }}
    {%- if wp.use_execution_time -%}
    , t={{ wp.execution_time }}
    {%- endif -%}
    {%- if wp.use_blend_radius -%}
    , r={{ wp.blend_radius }}
    {%- endif -%})
  else:
    socket_send_line("No inverse kinematics solution found, aborting.", "ur_driver_socket")
    return False
  end
  {%- endif %}
  {%- endfor %}
  
  return True
end