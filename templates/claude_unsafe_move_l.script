# claude_unsafe_move_l
#
# movel to an absolute pose in the base frame. Unguarded.
#
# Fixes over unsafe_move_l.script:
#   * global_velocity_scaling / global_acceleration_scaling are applied.
#   * The target is checked for reachability before the move is started, so an
#     unreachable pose comes back as a clean request failure with a reason
#     instead of a controller runtime error that only shows on the pendant.
#
# Optional parameters:
#   check_safety_limits (true) - also check the target against the active safety
#                                planes, joint limits and tool orientation limit,
#                                not only whether inverse kinematics has a
#                                solution. This is what catches a pose that is
#                                reachable but would trip a protective stop.

global cl_vel = 0.0
global cl_acc = 0.0

def script():
  cl_vel = {{ velocity }}
  cl_acc = {{ acceleration }}
  if {{ global_velocity_scaling }} > 0.0 and {{ global_velocity_scaling }} <= 1.0:
    cl_vel = cl_vel * {{ global_velocity_scaling }}
  end
  if {{ global_acceleration_scaling }} > 0.0 and {{ global_acceleration_scaling }} <= 1.0:
    cl_acc = cl_acc * {{ global_acceleration_scaling }}
  end

  {%- if use_payload %}
  set_target_payload({{ payload }})
  {%- endif %}
  set_tcp({{ tcp_in_faceplate }})

  if not get_inverse_kin_has_solution({{ target_in_base }}
  {%- if use_preferred_joint_config -%}
  , qnear={{ preferred_joint_config }}
  {%- endif -%}):
    socket_send_line("Target pose is not reachable, aborting.", "ur_driver_socket")
    return False
  end
  {%- if check_safety_limits | default(value=true) %}
  if not is_within_safety_limits({{ target_in_base }}):
    socket_send_line("Target pose is outside the active safety limits, aborting.", "ur_driver_socket")
    return False
  end
  {%- endif %}

  movel({{ target_in_base }}, a=cl_acc, v=cl_vel
  {%- if use_execution_time -%}
  , t={{ execution_time }}
  {%- endif -%}
  {%- if use_blend_radius -%}
  , r={{ blend_radius }}
  {%- endif -%})
  return True
end
