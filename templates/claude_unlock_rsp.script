# claude_unlock_rsp
#
# Unlocks the RSP tool changer. See claude_lock_rsp.script.
#
# Unlocking drops whatever is on the coupler, so this one refuses to run while
# the arm is moving - an unlock issued into a move that has not finished braking
# releases the tool with the arm still carrying it sideways.
#
# Optional parameters:
#   steady_timeout      (1.0)  - seconds to wait for the arm to reach standstill
#                                before refusing. is_steady() needs 500ms of
#                                stillness, so a single check would fail a script
#                                that starts right after the previous one.

def cl_wait_steady(timeout):
  # is_steady() only turns true after 500ms of standstill with zero target
  # velocity, so a script that starts right after the previous one finished
  # braking sees false for up to half a second. Checking it once would fail
  # perfectly good requests; this waits for it instead.
  local waited = 0.0
  while not is_steady():
    if waited >= timeout:
      return False
    end
    sleep(0.02)
    waited = waited + 0.02
  end
  return True
end

def script():
  if not cl_wait_steady({{ steady_timeout | default(value=1.0) }}):
    socket_send_line("The arm did not come to a standstill, refusing to unlock the RSP.", "ur_driver_socket")
    return False
  end
  set_standard_digital_out({{ rsp_pin | default(value=1) }}, True)
  sleep({{ rsp_settle_time | default(value=0.5) }})
  {%- if rsp_locked_in_pin | default(value=-1) >= 0 %}
  if get_standard_digital_in({{ rsp_locked_in_pin | default(value=-1) }}):
    socket_send_line("RSP still reports locked after {{ rsp_settle_time | default(value=0.5) }}s.", "ur_driver_socket")
    return False
  end
  {%- endif %}
  socket_send_line("RSP unlocked", "ur_driver_socket")
  return True
end
